# No DJANGO_SETTINGS_MODULE here on purpose in real local .env files —
# docker-compose.yml's web service loads this same file via env_file:,
# so setting it here would also override the Dockerfile's own
# ENV DJANGO_SETTINGS_MODULE=production inside the container. Omit it
# and let manage.py's own default ("development") apply on bare host
# commands, while Docker's container stays on production either way.
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key

# Postgres connection — used by development.py and test.py locally
# (not just production.py). DB_NAME/DB_USER/DB_HOST/DB_PORT below match
# development.py's own fallback defaults, so they're only needed if you
# want different values — but DB_PASSWORD has no safe fallback (empty
# string) and MUST match the root .env's DB_PASSWORD, since that's what
# Docker uses to initialize the db container's actual Postgres role.
# Requires docker-compose.override.yml (copied from the .example)
# publishing db's port to the host — see README.md's Development
# Workflow section.
DB_NAME=fpw
DB_USER=fpw
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Required (no default, fails loudly on startup) when
# DJANGO_SETTINGS_MODULE=backend.settings.production — which the
# Dockerfile always sets inside the container, so `docker compose up
# --build` needs a real value here even for local testing, not just
# an eventual real domain in production. localhost/127.0.0.1 is enough
# for the container-level verification this repo's docker-compose.yml
# is meant for (web has no published host port / local TLS — see
# README.md's Deployment strategy section). Replace with the real
# domain once one exists.
ALLOWED_HOSTS=localhost,127.0.0.1

# Needed for the subscribe form's CSRF check, and for CORS if anything
# consumes /api/ cross-origin. Safe defaults (empty = no origins
# allowed) if left unset, but set here to match ALLOWED_HOSTS above for
# local docker-compose testing. Replace with the real domain in
# production.
CORS_ALLOWED_ORIGINS=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
