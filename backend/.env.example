# No DJANGO_SETTINGS_MODULE here on purpose in real local .env files —
# docker-compose.yml's web service loads this same file via env_file:,
# so setting it here would also override the Dockerfile's own
# ENV DJANGO_SETTINGS_MODULE=production inside the container. Omit it
# and let manage.py's own default ("development") apply on bare host
# commands, while Docker's container stays on production either way.
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key

# Postgres connection — used by development.py and test.py locally
# (not just production.py). Defaults already match Docker's db
# container (see docker-compose.yml/.env.example) if left unset, so
# these are only needed if you want different values. Requires
# docker-compose.override.yml (copied from the .example) publishing
# db's port to the host — see CLAUDE.md's Development Workflow.
# DB_NAME=fpw
# DB_USER=fpw
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# Production only
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Required (no default) when DJANGO_SETTINGS_MODULE=backend.settings.production:
# ALLOWED_HOSTS=yourdomain.com
