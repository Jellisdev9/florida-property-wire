DJANGO_SETTINGS_MODULE=backend.settings.development
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key

# Production only — leave blank for development (SQLite is used by default)
# DB_NAME=fpw
# DB_USER=fpw
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Required (no default) when DJANGO_SETTINGS_MODULE=backend.settings.production:
# ALLOWED_HOSTS=yourdomain.com
