# Docker Compose var-substitution file (DB_NAME/USER/PASSWORD, SITE_ADDRESS)
/.env

# Local dev convenience only — publishes db's Postgres port to the host so
# host-based `manage.py test`/`runserver` can reach it without a native
# Postgres install. Must never be committed: docker-compose.yml's deploy
# job runs plain `docker compose up -d`, which auto-loads this file if
# present — committing it would expose Postgres publicly on the VPS.
/docker-compose.override.yml

