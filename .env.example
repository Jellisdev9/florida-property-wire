# Vars docker-compose.yml itself interpolates (${VAR} syntax).
# The Django app's own env vars (SECRET_KEY, ALLOWED_HOSTS, etc.) live
# separately in backend/.env — see backend/.env.example.

DB_NAME=fpw
DB_USER=fpw
DB_PASSWORD=changeme

# localhost -> Caddy serves via its internal self-signed CA (real local
#   HTTPS, no mkcert needed).
# yourdomain.com -> Caddy automatically requests a real Let's Encrypt cert.
SITE_ADDRESS=localhost

# --- Postgres backups (backup/ service) ---
# Nightly pg_dump piped through rclone to any S3-compatible bucket (AWS S3,
# Backblaze B2, Cloudflare R2, MinIO, ...). Leave BACKUP_BUCKET blank to
# disable — the backup container just logs and skips each cycle, so local
# dev works fine with none of this set. Set retention with a lifecycle
# rule on the bucket itself (e.g. expire objects after 30 days) rather
# than in app code.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_BUCKET=your-bucket-name
# RCLONE_CONFIG_REMOTE_TYPE=s3
# RCLONE_CONFIG_REMOTE_PROVIDER=Other   # "AWS" for real AWS S3, "Other" for B2/R2/MinIO
# RCLONE_CONFIG_REMOTE_ACCESS_KEY_ID=
# RCLONE_CONFIG_REMOTE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_REMOTE_ENDPOINT=        # e.g. s3.us-west-000.backblazeb2.com — omit for real AWS S3
# RCLONE_CONFIG_REMOTE_REGION=
